{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yuki-Mobile acceptance run manifest",
  "type": "object",
  "required": [
    "case_id", "started_at", "client_platform", "device_model", "os_build",
    "backend_commit", "desktop_commit", "mobile_commit", "mobile_source_modified",
    "build_type", "build_sha256", "entry_kind", "test_entry_alias", "id_aliases",
    "fault_point", "steps", "expected", "observed", "evidence_paths", "status",
    "limitations", "rerun_command"
  ],
  "properties": {
    "case_id": {
      "pattern": "^(A(0[1-9]|1[0-689]|20)|smoke|env-check|desktop-handoff)$",
      "type": "string"
    },
    "started_at": { "type": "string", "format": "date-time" },
    "client_platform": { "enum": ["reference", "desktop", "android"] },
    "device_model": { "type": ["string", "null"] },
    "os_build": { "type": ["string", "null"] },
    "backend_commit": { "$ref": "#/$defs/commit" },
    "desktop_commit": { "$ref": "#/$defs/commit" },
    "mobile_commit": { "$ref": "#/$defs/commit" },
    "mobile_source_modified": { "type": ["boolean", "null"] },
    "build_type": { "enum": ["debug", "release"] },
    "build_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "entry_kind": { "type": ["string", "null"] },
    "test_entry_alias": { "type": ["string", "null"], "pattern": "^entry-[1-9][0-9]{0,2}$" },
    "id_aliases": { "type": "object", "additionalProperties": { "type": "string" } },
    "fault_point": { "type": ["string", "null"] },
    "steps": { "$ref": "#/$defs/strings" },
    "expected": { "$ref": "#/$defs/strings" },
    "observed": { "type": "object" },
    "evidence_paths": { "$ref": "#/$defs/strings" },
    "status": { "enum": ["passed", "failed", "blocked", "not_run"] },
    "limitations": { "$ref": "#/$defs/strings" },
    "rerun_command": { "type": "string" },
    "tls_trusted": { "type": "boolean" },
    "test_route_blocked": { "type": "boolean" }
  },
  "additionalProperties": false,
  "$defs": {
    "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "strings": { "type": "array", "items": { "type": "string" } }
  }
}
